# Where `npm run dev` proxies /api. Committed because it is a local default,
# not a secret. Override per-machine in .env.local (gitignored by Vite).
#
# 127.0.0.1, not localhost: Ollama and uvicorn bind IPv4, and on Windows
# "localhost" resolves to ::1 first, costing ~2s per request.
VITE_API_TARGET=http://127.0.0.1:8001
