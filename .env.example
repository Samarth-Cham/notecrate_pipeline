DATABASE_URL=postgresql://postgres:notecrate@localhost:5432/notecrate

# Ollama
#
# Use 127.0.0.1, NOT localhost. Ollama binds IPv4 only, while "localhost"
# resolves to ::1 first on Windows — so every call waits for the IPv6 attempt
# to fail before retrying IPv4. Measured on this project: 2.10s per request
# via localhost against 0.06s via 127.0.0.1, on every embedding and every
# generation. A single question makes ~9 of these calls.
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Auth
#
# Generate a signing key — do not reuse this placeholder, and do not commit
# a real one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# There is intentionally no default in code. A signing key that falls back to
# a constant is not a signing key: anyone reading the repo could mint a token
# claiming the `senior` role.
JWT_SECRET=
JWT_TTL_HOURS=12

# Password for the local demo accounts created by `python src/auth.py seed`
# (jamie/junior, sam/senior). Pick your own; the seed refuses to run without it.
DEMO_USER_PASSWORD=
