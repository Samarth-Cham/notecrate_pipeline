.env
__pycache__/
*.pyc
data/raw/*
data/cleaned/*
data/chunks/*
!data/raw/.gitkeep
!data/processed/.gitkeep
docs/*
ingestions/*
.venv/
.claude/*

# Frontend build artifacts. package-lock.json IS committed — the Dockerfile
# runs `npm ci`, which requires it.
frontend/node_modules/
frontend/dist/

# `.env` above matches at any depth, but frontend/.env holds no secrets — just
# which port the dev proxy points at — and `npm run dev` needs it to work
# without the caller exporting a shell variable. Per-machine overrides go in
# frontend/.env.local, which stays ignored.
!frontend/.env
frontend/.env.local

# Per-environment config (plan 3.5). The real files hold secrets and are
# created on the machine that uses them; only the templates are committed.
config/*.env
!config/*.env.example

# Regenerable candidate pools for the label set (eval/harvest_labels.py).
# The labels themselves — conflicts.jsonl, grounding.jsonl — and the frozen
# answers.jsonl they are attached to ARE committed: hand-made, and answers
# cannot be reproduced because generation runs at temperature 0.2.
eval/labels/_pool_*.jsonl
