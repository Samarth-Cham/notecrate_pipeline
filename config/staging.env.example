# Staging configuration (plan section 3.5: "Config split per environment ...
# never share one file across tiers").
#
# Copy to config/staging.env ON THE VM and fill in. That file is gitignored and
# must never be committed — generate its secrets on the machine that uses them
# rather than copying your laptop's, so a leak on one box does not compromise
# the other.
#
#   cp config/staging.env.example config/staging.env
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"   # JWT_SECRET
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"   # POSTGRES_PASSWORD

# --- database ----------------------------------------------------------------
# POSTGRES_PASSWORD is read by the db container; DATABASE_URL is read by the
# api container. The password appears in BOTH — change one and you must change
# the other, or the API cannot authenticate to its own database.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/notecrate

# --- model serving -----------------------------------------------------------
# The VM reaches Ollama on the VMware NAT host address, not localhost —
# localhost inside a container is the container. 192.168.94.1 is the Windows
# host's vmnet8 address; confirm yours with `ip route | grep default`.
#
# This requires OLLAMA_HOST=0.0.0.0:11434 on the host plus a firewall rule
# allowing 11434 only from 192.168.94.0/24. Ollama has no authentication of
# its own, so that firewall rule is the only thing protecting it.
OLLAMA_URL=http://192.168.94.1:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# --- auth --------------------------------------------------------------------
# No default in code: a signing key that falls back to a constant is not a
# signing key. Must be at least 32 bytes (RFC 7518 section 3.2).
JWT_SECRET=
JWT_TTL_HOURS=12

# Password for the demo accounts created by `python src/auth.py seed`.
# If this box is publicly reachable, use a generated value — these accounts
# are the only thing between the internet and the private-scoped corpus.
DEMO_USER_PASSWORD=
